# All paths must be absolute host paths. Copy this file to .env and chmod 600.
PROJECT_ROOT=/opt/noisyclip/project
TRAIN_ROOT=/mnt/noisyclip-data/init/train
TEST_ROOT=/mnt/noisyclip-data/init/test
RUN_ROOT=/mnt/noisyclip-runs
CACHE_ROOT=/mnt/noisyclip-cache

HOST_UID=1000
HOST_GID=1000
CUDA_VISIBLE_DEVICES=0
IMAGE_TAG=pt2.11-cu128

